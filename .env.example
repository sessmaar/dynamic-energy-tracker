# ─────────────────────────────────────────────────────────────────
# Dense Matrix – required environment variables
# Copy this file to apps/web/.env.local and fill in the values.
# Both vars must be set for the web app to connect to Supabase.
# ─────────────────────────────────────────────────────────────────

# --- Supabase ---------------------------------------------------------------

# Remote Project URL (Found in: Supabase Dashboard → Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anon Key (Found in: Supabase Dashboard → Settings → API)
SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (PRIVATE - NEVER EXPOSE ON FRONTEND)
# Used for administrative tasks, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Next.js (web) needs the NEXT_PUBLIC_ prefix to expose values to the browser
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# Expo (mobile) needs the EXPO_PUBLIC_ prefix
EXPO_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
EXPO_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
