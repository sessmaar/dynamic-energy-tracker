# ─────────────────────────────────────────────────────────────────
# Dense Matrix – required environment variables
# Copy this file to apps/web/.env.local and fill in the values.
# Both vars must be set for the web app to connect to Supabase.
# ─────────────────────────────────────────────────────────────────

# Found in: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Found in: Supabase Dashboard → Project Settings → API → anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
